ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://payseal:payseal_dev@postgres:5432/payseal
JWT_SECRET=local-dev-jwt-secret-change-before-production-2026
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_TOKEN_SECRET=local-dev-refresh-token-pepper-change-in-production
REFRESH_COOKIE_SECURE=false
ACCOUNT_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ACCOUNT_LOOKUP_HMAC_KEY=local-dev-account-lookup-hmac-change-in-production
KEY_ENCRYPTION_SECRET=local-dev-key-wrapping-secret-change-in-production
PAYSEAL_ROOT_KEY_PATH=/keys/root-private.pem.enc
PAYSEAL_ROOT_PUBLIC_KEY_PATH=/keys/root-public.pem
SIGNING_KEY_DIRECTORY=/keys/organizations
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=payseal_minio
MINIO_SECRET_KEY=payseal_minio_local_dev_secret
MINIO_BUCKET=payseal-documents
MINIO_SECURE=false
PUBLIC_VERIFY_BASE_URL=http://localhost:3000/r
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,backend,nginx,testserver
MAX_PDF_BYTES=10485760
MFA_RECENT_WINDOW_SECONDS=300
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Default stays sandbox. Live also requires HTTPS/production/security gates and a connected channel.
TRANSFER_MODE=sandbox
# Optional: generate a separate random secret (32+ bytes) to enable sandbox webhooks.
# Keep empty to reject all external transfer callbacks.
TRANSFER_WEBHOOK_SECRET=
MAX_BUSINESS_DOCUMENT_BYTES=5242880
PAYMENTS_LIVE_ENABLED=false
PUBLIC_APP_URL=
MAX_LIVE_TRANSFER_AMOUNT=1000000

