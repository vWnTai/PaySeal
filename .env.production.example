# Fresh production installation only. Use scripts/prepare-production.ps1 to generate unique secrets.
# NEVER use this template unchanged or replace encryption keys for an existing database.
PAYSEAL_DOMAIN=replace-with-your-real-domain
ENVIRONMENT=production
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_TOKEN_SECRET=
REFRESH_COOKIE_SECURE=true
ACCOUNT_ENCRYPTION_KEY=
ACCOUNT_LOOKUP_HMAC_KEY=
KEY_ENCRYPTION_SECRET=
PAYSEAL_ROOT_KEY_PATH=/keys/root-private.pem.enc
PAYSEAL_ROOT_PUBLIC_KEY_PATH=/keys/root-public.pem
SIGNING_KEY_DIRECTORY=/keys/organizations
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=payseal-documents
MINIO_SECURE=false
PUBLIC_APP_URL=
PUBLIC_VERIFY_BASE_URL=
CORS_ORIGINS=
TRUSTED_HOSTS=localhost,backend
NEXT_PUBLIC_API_BASE_URL=/api/v1
TRANSFER_MODE=disabled
PAYMENTS_LIVE_ENABLED=false
MAX_LIVE_TRANSFER_AMOUNT=1000000
TRANSFER_WEBHOOK_SECRET=
MAX_PDF_BYTES=10485760
MAX_BUSINESS_DOCUMENT_BYTES=5242880
MFA_RECENT_WINDOW_SECONDS=300
